server {
    listen 80;

    # SPA: estáticos, con fallback a index.html para las rutas del router
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Qué commit corre este front: el pipeline lo hornea en la imagen (build-arg COMMIT_SHA);
    # el default es "unknown". El smoke del deploy lo compara con el commit esperado.
    location = /version {
        default_type text/plain;
        add_header Cache-Control "no-store";
        return 200 "${COMMIT_SHA}";
    }

    # La dirección del backend y el DNS llegan por variables de entorno: en compose,
    # el nombre del servicio y el DNS de Docker; en Render, la URL de la api de ESTE
    # entorno y un DNS público.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $backend_api ${BACKEND_URL};

    # El front pide /api/...; la api no tiene ese prefijo, así que se lo sacamos.
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_api;
        proxy_ssl_server_name on;   # la api de Render es https: sin esto el TLS no sabe a qué host va
    }
}
