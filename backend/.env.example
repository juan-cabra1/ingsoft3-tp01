# Database
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/bako_store
MYSQL_DATABASE=
# JWT
JWT_SECRET_KEY=change_me_to_a_random_64_char_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# WhatsApp
WHATSAPP_NUMBER=123456789

# Admin seed (first run only)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Observability
SENTRY_DSN=
ENVIRONMENT=development

# Cloudinary (image storage — leave empty to use local filesystem in dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
